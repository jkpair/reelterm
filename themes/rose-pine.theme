# yt-x Theme: Rosé Pine
# All natural pine, faux fur and a bit of soho vibes
# https://rosepinetheme.com/

# Theme metadata
THEME_NAME="Rosé Pine"
THEME_AUTHOR="Rosé Pine, yt-x adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;167m'        # #eb6f92
COLOR_GREEN='\033[38;5;108m'      # #9ccfd8 (foam - used as green)
COLOR_YELLOW='\033[38;5;222m'     # #f6c177
COLOR_BLUE='\033[38;5;110m'       # #31748f (pine)
COLOR_MAGENTA='\033[38;5;183m'    # #c4a7e7 (iris)
COLOR_CYAN='\033[38;5;116m'       # #9ccfd8 (foam)
COLOR_ORANGE='\033[38;5;216m'     # #f6c177 (gold)

# Neutral colors
COLOR_GRAY='\033[38;5;60m'        # #6e6a86 (muted)
COLOR_WHITE='\033[38;5;254m'      # #e0def4 (text)
COLOR_DIM='\033[38;5;245m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#e0def4,fg+:#e0def4,bg:#191724,bg+:#26233a
  --color=hl:#9ccfd8,hl+:#9ccfd8,info:#c4a7e7,marker:#eb6f92
  --color=prompt:#eb6f92,spinner:#c4a7e7,pointer:#c4a7e7,header:#9ccfd8
  --color=border:#6e6a86,label:#e0def4,query:#e0def4
  --color=gutter:#191724,scrollbar:#6e6a86
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#e0def4"
GUM_CONFIRM_SELECTED_BACKGROUND="#9ccfd8"
GUM_CONFIRM_SELECTED_FOREGROUND="#191724"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#26233a"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#e0def4"
GUM_INPUT_CURSOR_FOREGROUND="#9ccfd8"
GUM_INPUT_PROMPT_FOREGROUND="#c4a7e7"
GUM_INPUT_HEADER_FOREGROUND="#9ccfd8"
GUM_SPIN_SPINNER_FOREGROUND="#c4a7e7"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
