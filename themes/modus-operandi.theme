# yt-x Theme: Modus Operandi
# High-contrast light theme conforming to WCAG AAA accessibility standard
# https://protesilaos.com/emacs/modus-themes

# Theme metadata
THEME_NAME="Modus Operandi"
THEME_AUTHOR="Protesilaos Stavrou, yt-x adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;160m'        # #a60000
COLOR_GREEN='\033[38;5;28m'       # #006800
COLOR_YELLOW='\033[38;5;136m'     # #6f5500
COLOR_BLUE='\033[38;5;21m'        # #0031a9
COLOR_MAGENTA='\033[38;5;127m'    # #721045
COLOR_CYAN='\033[38;5;30m'        # #005e8b
COLOR_ORANGE='\033[38;5;130m'     # #884900

# Neutral colors
COLOR_GRAY='\033[38;5;247m'       # #9f9f9f
COLOR_WHITE='\033[38;5;16m'       # #000000 (fg)
COLOR_DIM='\033[38;5;249m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#000000,fg+:#000000,bg:#ffffff,bg+:#e0e0e0
  --color=hl:#0031a9,hl+:#0031a9,info:#006800,marker:#006800
  --color=prompt:#a60000,spinner:#721045,pointer:#721045,header:#0031a9
  --color=border:#9f9f9f,label:#000000,query:#000000
  --color=gutter:#ffffff,scrollbar:#9f9f9f
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#000000"
GUM_CONFIRM_SELECTED_BACKGROUND="#006800"
GUM_CONFIRM_SELECTED_FOREGROUND="#ffffff"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#e0e0e0"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#000000"
GUM_INPUT_CURSOR_FOREGROUND="#006800"
GUM_INPUT_PROMPT_FOREGROUND="#005e8b"
GUM_INPUT_HEADER_FOREGROUND="#0031a9"
GUM_SPIN_SPINNER_FOREGROUND="#005e8b"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
