# reelterm Theme: Monokai Pro
# The classic Sublime Text color scheme
# https://monokai.pro/

# Theme metadata
THEME_NAME="Monokai Pro"
THEME_AUTHOR="Wimer Hazenberg, reelterm adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;204m'        # #ff6188
COLOR_GREEN='\033[38;5;114m'      # #a9dc76
COLOR_YELLOW='\033[38;5;221m'     # #ffd866
COLOR_BLUE='\033[38;5;81m'        # #78dce8
COLOR_MAGENTA='\033[38;5;176m'    # #ab9df2
COLOR_CYAN='\033[38;5;81m'        # #78dce8
COLOR_ORANGE='\033[38;5;209m'     # #fc9867

# Neutral colors
COLOR_GRAY='\033[38;5;59m'        # #5b595c
COLOR_WHITE='\033[38;5;252m'      # #fcfcfa
COLOR_DIM='\033[38;5;245m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#fcfcfa,fg+:#fcfcfa,bg:#2d2a2e,bg+:#403e41
  --color=hl:#78dce8,hl+:#78dce8,info:#a9dc76,marker:#a9dc76
  --color=prompt:#ff6188,spinner:#ab9df2,pointer:#ab9df2,header:#78dce8
  --color=border:#5b595c,label:#fcfcfa,query:#fcfcfa
  --color=gutter:#2d2a2e,scrollbar:#5b595c
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#fcfcfa"
GUM_CONFIRM_SELECTED_BACKGROUND="#a9dc76"
GUM_CONFIRM_SELECTED_FOREGROUND="#2d2a2e"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#403e41"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#fcfcfa"
GUM_INPUT_CURSOR_FOREGROUND="#a9dc76"
GUM_INPUT_PROMPT_FOREGROUND="#78dce8"
GUM_INPUT_HEADER_FOREGROUND="#78dce8"
GUM_SPIN_SPINNER_FOREGROUND="#78dce8"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
