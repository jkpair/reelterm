# reelterm Theme: Nord
# An arctic, north-bluish color palette
# https://www.nordtheme.com/

# Theme metadata
THEME_NAME="Nord"
THEME_AUTHOR="Arctic Ice Studio, reelterm adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;168m'        # #bf616a
COLOR_GREEN='\033[38;5;108m'      # #a3be8c
COLOR_YELLOW='\033[38;5;179m'     # #ebcb8b
COLOR_BLUE='\033[38;5;67m'        # #5e81ac
COLOR_MAGENTA='\033[38;5;139m'    # #b48ead
COLOR_CYAN='\033[38;5;110m'       # #88c0d0
COLOR_ORANGE='\033[38;5;173m'     # #d08770

# Neutral colors
COLOR_GRAY='\033[38;5;60m'        # #4c566a
COLOR_WHITE='\033[38;5;188m'      # #d8dee9
COLOR_DIM='\033[38;5;245m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#d8dee9,fg+:#eceff4,bg:#2e3440,bg+:#3b4252
  --color=hl:#88c0d0,hl+:#8fbcbb,info:#a3be8c,marker:#a3be8c
  --color=prompt:#bf616a,spinner:#b48ead,pointer:#b48ead,header:#88c0d0
  --color=border:#4c566a,label:#d8dee9,query:#d8dee9
  --color=gutter:#2e3440,scrollbar:#4c566a
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#d8dee9"
GUM_CONFIRM_SELECTED_BACKGROUND="#a3be8c"
GUM_CONFIRM_SELECTED_FOREGROUND="#2e3440"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#3b4252"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#d8dee9"
GUM_INPUT_CURSOR_FOREGROUND="#a3be8c"
GUM_INPUT_PROMPT_FOREGROUND="#88c0d0"
GUM_INPUT_HEADER_FOREGROUND="#5e81ac"
GUM_SPIN_SPINNER_FOREGROUND="#88c0d0"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
