# yt-x Theme: Cyberdream
# High-contrast neon cyberpunk color scheme
# https://github.com/scottmckendry/cyberdream.nvim

# Theme metadata
THEME_NAME="Cyberdream"
THEME_AUTHOR="scottmckendry, yt-x adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;203m'        # #ff6e5e
COLOR_GREEN='\033[38;5;84m'       # #5eff6c
COLOR_YELLOW='\033[38;5;227m'     # #f1ff5e
COLOR_BLUE='\033[38;5;75m'        # #5ea1ff
COLOR_MAGENTA='\033[38;5;177m'    # #bd5eff
COLOR_CYAN='\033[38;5;86m'        # #5ef1ff
COLOR_ORANGE='\033[38;5;215m'     # #ffbd5e

# Neutral colors
COLOR_GRAY='\033[38;5;243m'       # #7b8496
COLOR_WHITE='\033[38;5;255m'      # #ffffff
COLOR_DIM='\033[38;5;245m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#ffffff,fg+:#ffffff,bg:#16181a,bg+:#1e2124
  --color=hl:#5ea1ff,hl+:#5ef1ff,info:#5eff6c,marker:#5eff6c
  --color=prompt:#ff6e5e,spinner:#bd5eff,pointer:#bd5eff,header:#5ea1ff
  --color=border:#7b8496,label:#ffffff,query:#ffffff
  --color=gutter:#16181a,scrollbar:#7b8496
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#ffffff"
GUM_CONFIRM_SELECTED_BACKGROUND="#5eff6c"
GUM_CONFIRM_SELECTED_FOREGROUND="#16181a"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#1e2124"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#ffffff"
GUM_INPUT_CURSOR_FOREGROUND="#5eff6c"
GUM_INPUT_PROMPT_FOREGROUND="#5ef1ff"
GUM_INPUT_HEADER_FOREGROUND="#5ea1ff"
GUM_SPIN_SPINNER_FOREGROUND="#5ef1ff"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
