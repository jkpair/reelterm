# yt-x Theme: Modus Vivendi
# High-contrast dark theme conforming to WCAG AAA accessibility standard
# https://protesilaos.com/emacs/modus-themes

# Theme metadata
THEME_NAME="Modus Vivendi"
THEME_AUTHOR="Protesilaos Stavrou, yt-x adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;210m'        # #ff5f59
COLOR_GREEN='\033[38;5;114m'      # #44bc44
COLOR_YELLOW='\033[38;5;222m'     # #d0bc00
COLOR_BLUE='\033[38;5;111m'       # #2fafff
COLOR_MAGENTA='\033[38;5;183m'    # #feacd0
COLOR_CYAN='\033[38;5;116m'       # #00d3d0
COLOR_ORANGE='\033[38;5;216m'     # #fec43f

# Neutral colors
COLOR_GRAY='\033[38;5;245m'       # #989898
COLOR_WHITE='\033[38;5;255m'      # #ffffff
COLOR_DIM='\033[38;5;245m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#ffffff,fg+:#ffffff,bg:#000000,bg+:#1e1e1e
  --color=hl:#2fafff,hl+:#79a8ff,info:#44bc44,marker:#44bc44
  --color=prompt:#ff5f59,spinner:#feacd0,pointer:#feacd0,header:#2fafff
  --color=border:#989898,label:#ffffff,query:#ffffff
  --color=gutter:#000000,scrollbar:#989898
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#ffffff"
GUM_CONFIRM_SELECTED_BACKGROUND="#44bc44"
GUM_CONFIRM_SELECTED_FOREGROUND="#000000"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#1e1e1e"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#ffffff"
GUM_INPUT_CURSOR_FOREGROUND="#44bc44"
GUM_INPUT_PROMPT_FOREGROUND="#00d3d0"
GUM_INPUT_HEADER_FOREGROUND="#2fafff"
GUM_SPIN_SPINNER_FOREGROUND="#00d3d0"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
