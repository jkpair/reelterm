# reelterm Theme: One Dark
# Atom editor's iconic dark color scheme
# https://github.com/atom/one-dark-syntax

# Theme metadata
THEME_NAME="One Dark"
THEME_AUTHOR="Atom/GitHub, reelterm adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;204m'        # #e06c75
COLOR_GREEN='\033[38;5;114m'      # #98c379
COLOR_YELLOW='\033[38;5;180m'     # #e5c07b
COLOR_BLUE='\033[38;5;39m'        # #61afef
COLOR_MAGENTA='\033[38;5;170m'    # #c678dd
COLOR_CYAN='\033[38;5;38m'        # #56b6c2
COLOR_ORANGE='\033[38;5;209m'     # #d19a66

# Neutral colors
COLOR_GRAY='\033[38;5;59m'        # #5c6370
COLOR_WHITE='\033[38;5;145m'      # #abb2bf
COLOR_DIM='\033[38;5;245m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#abb2bf,fg+:#abb2bf,bg:#282c34,bg+:#3e4452
  --color=hl:#61afef,hl+:#61afef,info:#98c379,marker:#98c379
  --color=prompt:#e06c75,spinner:#c678dd,pointer:#c678dd,header:#61afef
  --color=border:#5c6370,label:#abb2bf,query:#abb2bf
  --color=gutter:#282c34,scrollbar:#5c6370
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#abb2bf"
GUM_CONFIRM_SELECTED_BACKGROUND="#98c379"
GUM_CONFIRM_SELECTED_FOREGROUND="#282c34"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#3e4452"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#abb2bf"
GUM_INPUT_CURSOR_FOREGROUND="#98c379"
GUM_INPUT_PROMPT_FOREGROUND="#56b6c2"
GUM_INPUT_HEADER_FOREGROUND="#61afef"
GUM_SPIN_SPINNER_FOREGROUND="#56b6c2"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
