# reelterm Theme: Rosé Pine Dawn
# All natural pine, faux fur and a bit of soho vibes - light variant
# https://rosepinetheme.com/

# Theme metadata
THEME_NAME="Rosé Pine Dawn"
THEME_AUTHOR="Rosé Pine, reelterm adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;131m'        # #b4637a
COLOR_GREEN='\033[38;5;66m'       # #56949f (foam)
COLOR_YELLOW='\033[38;5;172m'     # #ea9d34
COLOR_BLUE='\033[38;5;60m'        # #286983 (pine)
COLOR_MAGENTA='\033[38;5;97m'     # #907aa9 (iris)
COLOR_CYAN='\033[38;5;66m'        # #56949f (foam)
COLOR_ORANGE='\033[38;5;172m'     # #ea9d34 (gold)

# Neutral colors
COLOR_GRAY='\033[38;5;145m'       # #9893a5 (muted)
COLOR_WHITE='\033[38;5;59m'       # #575279 (text)
COLOR_DIM='\033[38;5;249m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#575279,fg+:#575279,bg:#faf4ed,bg+:#f2e9e1
  --color=hl:#286983,hl+:#56949f,info:#907aa9,marker:#b4637a
  --color=prompt:#b4637a,spinner:#907aa9,pointer:#907aa9,header:#56949f
  --color=border:#9893a5,label:#575279,query:#575279
  --color=gutter:#faf4ed,scrollbar:#9893a5
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#575279"
GUM_CONFIRM_SELECTED_BACKGROUND="#56949f"
GUM_CONFIRM_SELECTED_FOREGROUND="#faf4ed"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#f2e9e1"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#575279"
GUM_INPUT_CURSOR_FOREGROUND="#56949f"
GUM_INPUT_PROMPT_FOREGROUND="#907aa9"
GUM_INPUT_HEADER_FOREGROUND="#56949f"
GUM_SPIN_SPINNER_FOREGROUND="#907aa9"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
