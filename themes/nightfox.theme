# reelterm Theme: Nightfox
# A soft dark colorscheme with medium contrast
# https://github.com/EdenEast/nightfox.nvim

# Theme metadata
THEME_NAME="Nightfox"
THEME_AUTHOR="EdenEast, reelterm adaptation"
THEME_VERSION="1.0"

# =============================================================================
# TERMINAL COLORS (256-color palette)
# =============================================================================

# Primary colors
COLOR_RED='\033[38;5;174m'        # #c94f6d
COLOR_GREEN='\033[38;5;108m'      # #81b29a
COLOR_YELLOW='\033[38;5;222m'     # #dbc074
COLOR_BLUE='\033[38;5;110m'       # #719cd6
COLOR_MAGENTA='\033[38;5;176m'    # #9d79d6
COLOR_CYAN='\033[38;5;109m'       # #63cdcf
COLOR_ORANGE='\033[38;5;209m'     # #f4a261

# Neutral colors
COLOR_GRAY='\033[38;5;60m'        # #575860 (comment)
COLOR_WHITE='\033[38;5;188m'      # #cdcecf (fg)
COLOR_DIM='\033[38;5;245m'

# Text styles
STYLE_BOLD='\033[1m'
STYLE_DIM='\033[2m'
STYLE_ITALIC='\033[3m'
STYLE_RESET='\033[0m'

# =============================================================================
# FZF THEME
# =============================================================================

FZF_COLORS='
  --color=fg:#cdcecf,fg+:#cdcecf,bg:#192330,bg+:#283648
  --color=hl:#719cd6,hl+:#63cdcf,info:#81b29a,marker:#81b29a
  --color=prompt:#c94f6d,spinner:#9d79d6,pointer:#9d79d6,header:#719cd6
  --color=border:#575860,label:#cdcecf,query:#cdcecf
  --color=gutter:#192330,scrollbar:#575860
'

FZF_STYLE='
  --border="rounded" --border-label="" --preview-window="border-rounded"
  --prompt="  " --marker=" " --pointer="▌"
  --separator="─" --scrollbar="▐"  --padding="0,1" --margin="0"
'

# =============================================================================
# UI ELEMENTS
# =============================================================================

BOX_TOP_LEFT="╭"
BOX_TOP_RIGHT="╮"
BOX_BOTTOM_LEFT="╰"
BOX_BOTTOM_RIGHT="╯"
BOX_HORIZONTAL="─"
BOX_VERTICAL="│"
BOX_SEPARATOR="┈"

# =============================================================================
# GUM THEME (hex colors for charmbracelet/gum)
# =============================================================================
GUM_CONFIRM_PROMPT_FOREGROUND="#cdcecf"
GUM_CONFIRM_SELECTED_BACKGROUND="#81b29a"
GUM_CONFIRM_SELECTED_FOREGROUND="#192330"
GUM_CONFIRM_UNSELECTED_BACKGROUND="#283648"
GUM_CONFIRM_UNSELECTED_FOREGROUND="#cdcecf"
GUM_INPUT_CURSOR_FOREGROUND="#81b29a"
GUM_INPUT_PROMPT_FOREGROUND="#63cdcf"
GUM_INPUT_HEADER_FOREGROUND="#719cd6"
GUM_SPIN_SPINNER_FOREGROUND="#63cdcf"

# Icons (Nerd Font required)
ICON_HOME="󰋜"
ICON_SEARCH=""
ICON_PLAYLIST="󰐑"
ICON_WATCH_LATER=""
ICON_LIKED=""
ICON_SAVED=""
ICON_HISTORY=""
ICON_RECENT=""
ICON_SUBSCRIPTION="󰵀"
ICON_CHANNEL="󰑈"
ICON_CUSTOM=""
ICON_CLIPS=""
ICON_SETTINGS=""
ICON_CONFIG=""
ICON_EXIT="󰈆"
ICON_PLAY=""
ICON_DOWNLOAD=""
ICON_AUDIO=""
