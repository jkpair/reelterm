#!/usr/bin/env bash
# yt-x is now reelterm, a Go binary: https://github.com/jkpair/reelterm
#
# This file replaces the old Bash script so existing installs migrate on
# their next update ("Check for Updates" or `yt-x -U`): the old updater
# downloads this file and runs it, and it swaps itself for the binary of the
# latest release (keeping the yt-x file name, so the command still works).
# To install fresh, use install.sh from the releases page.
CLI_VERSION="1.2.1"

set -eu
repo="jkpair/reelterm"

case "$(uname -s)" in
Linux) os=linux ;;
Darwin) os=darwin ;;
*) echo "yt-x: unsupported OS $(uname -s); download a build from https://github.com/$repo/releases" >&2; exit 1 ;;
esac
case "$(uname -m)" in
x86_64 | amd64) arch=amd64 ;;
aarch64 | arm64) arch=arm64 ;;
armv7* | armv8l) arch=armv7 ;;
*) echo "yt-x: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

self="$(realpath "$0")"
tmp="$(mktemp "$(dirname "$self")/.yt-x-XXXXXX" 2>/dev/null || mktemp)"
trap 'rm -f "$tmp"' EXIT

echo "yt-x is now reelterm, rewritten in Go. Downloading the reelterm-$os-$arch binary..."
# Releases before the rename only have yt-x-<os>-<arch>.
curl -fL --progress-bar "https://github.com/$repo/releases/latest/download/reelterm-$os-$arch" -o "$tmp" ||
  curl -fL --progress-bar "https://github.com/$repo/releases/latest/download/yt-x-$os-$arch" -o "$tmp"
chmod 755 "$tmp"
"$tmp" --version >/dev/null

if [ -w "$self" ] && [ -w "$(dirname "$self")" ]; then
  mv -f "$tmp" "$self"
else
  sudo install -m 755 "$tmp" "$self"
fi
trap - EXIT
echo "Installed $("$self" --version) at $self"
echo "Your config, themes and saved data move to reelterm's folders on first start."
echo "Bash extensions are replaced by Lua plugins:"
echo "  https://github.com/$repo/blob/master/plugins/example.lua"
echo
exec "$self" "$@"
